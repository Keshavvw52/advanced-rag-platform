GROQ_API_KEY=your_groq_api_key_here
DEBUG=True
APP_NAME=Advanced RAG Platform
APP_VERSION=1.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DATABASE_URL=sqlite+aiosqlite:///./data/rag_platform.db
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=rag_documents
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5
RETRIEVAL_TOP_K=20
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512
RECURSIVE_CHUNK_SIZE=500
RECURSIVE_CHUNK_OVERLAP=50
PARENT_CHUNK_SIZE=1000
CHILD_CHUNK_SIZE=200
SEMANTIC_BREAKPOINT_THRESHOLD=0.85
BM25_WEIGHT=0.3
SEMANTIC_WEIGHT=0.7
RRF_K=60
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=50
EVAL_DATASET_PATH=./app/data/eval_dataset.json
